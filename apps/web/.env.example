NEXT_PUBLIC_BACKEND_DOMAIN=http://localhost:8000

# This is the backend/API origin, not the generated Netlify frontend domain.
# In Netlify, configure it under Project configuration > Environment variables.

# Optional overrides. Usually leave these empty and set only NEXT_PUBLIC_BACKEND_DOMAIN.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
